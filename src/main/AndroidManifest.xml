<?xml version="1.0" encoding="utf-8"?>
<!-- Modified 2026-10-12: host Application retained; private :x11 components; host desktop branding. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="false"
        tools:ignore="DataExtractionRules,GoogleAppIndexingWarning">
        <activity
            android:process=":x11"
            android:name="com.termux.x11.MainActivity"
            android:taskAffinity="${applicationId}.x11.MainActivity"
            android:icon="@mipmap/linuxapps_display_icon"
            android:roundIcon="@mipmap/linuxapps_display_icon"
            android:label="@string/lorie_app_name"
            android:theme="@style/LorieAppTheme"
            android:launchMode="singleInstance"
            android:supportsPictureInPicture="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:exported="false">
            <intent-filter>
                <category android:name="android.intent.category.SECONDARY_HOME" />
            </intent-filter>
        </activity>
        <activity
            android:process=":x11"
            android:name="com.termux.x11.MainActivity$MainActivityTagged"
            android:icon="@mipmap/linuxapps_display_icon"
            android:label="@string/lorie_app_name"
            android:taskAffinity=""
            android:theme="@style/LorieAppTheme"
            android:documentLaunchMode="intoExisting"
            android:supportsPictureInPicture="true"
            android:autoRemoveFromRecents="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:exported="false" />
        <activity
            android:process=":x11"
            android:theme="@style/Theme.AppCompat.DayNight"
            android:excludeFromRecents="true"
            android:name="com.termux.x11.LoriePreferences"
            android:label="@string/preferences_button_text"
            android:taskAffinity="${applicationId}.x11.LoriePreferences"
            android:supportsPictureInPicture="false"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
	    <meta-data android:name="android.allow_multiple_resumed_activities" android:value="true" />


        <receiver android:process=":x11" android:name="com.termux.x11.LoriePreferences$Receiver" android:exported="false" tools:ignore="ExportedReceiver" android:enabled="true">
            <intent-filter>
                <action android:name="com.termux.x11.CHANGE_PREFERENCE" />
            </intent-filter>
        </receiver>

        <receiver android:process=":x11" android:name="com.termux.x11.LorieApp$Receiver" android:exported="false" tools:ignore="ExportedReceiver" android:enabled="true">
            <intent-filter>
                <action android:name="com.termux.x11.CmdEntryPoint.ACTION_START" />
                <action android:name="com.termux.x11.ACTION_STOP" />
                <action android:name="com.termux.x11.ACTION_PREFERENCES_CHANGED" />
                <action android:name="com.termux.x11.ACTION_CUSTOM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
